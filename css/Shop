.store {
  padding: 80px 10%;
  text-align: center;
}

.products {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px,1fr));
  gap: 30px;
  margin-top: 40px;
}

.product-card {
  background: #1E293B;
  padding: 20px;
  border-radius: 12px;
}

.product-card img {
  width: 100%;
  border-radius: 8px;
}

.product-card h3 {
  margin-top: 15px;
}

.product-card p {
  margin: 10px 0;
  color: #CBD5E1;
}
